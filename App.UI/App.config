<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    CADENA DE CONEXION (solo desarrollo local)
    
    Por defecto usa autenticacion integrada de Windows: NO hay usuario ni contrasena en este archivo.
    Ajusta "Server" segun tu instalacion de SQL Server:
        Instancia por defecto ......... Server=localhost
        SQL Server Express ............ Server=.\SQLEXPRESS
        LocalDB ....................... Server=(localdb)\MSSQLLocalDB
    TrustServerCertificate=True evita errores de certificado en equipos locales; NO lo uses contra un servidor de produccion.

    Si necesitas autenticacion SQL (usuario/contrasena), NO las escribas aqui ni las subas a Git.
    Define la variable de entorno GYM_DB_CONNECTION con la cadena completa; tiene prioridad sobre este archivo.
    Ejemplo (PowerShell):
        $env:GYM_DB_CONNECTION = "Server=localhost;Database=GymDB;User Id=gym_user;Password=...;TrustServerCertificate=True;"
  -->
  <connectionStrings>
    <add name="GymDbConnection"
         connectionString="Server=localhost;Database=GymDB;Trusted_Connection=True;TrustServerCertificate=True;" />
  </connectionStrings>

  <appSettings>
    <!-- Intentos fallidos permitidos en la ventana de login antes de cerrar la aplicacion -->
    <add key="MaxIntentosLogin" value="3" />
    <!-- Bloqueo de cuenta: tras N intentos fallidos acumulados de un mismo usuario se bloquea M minutos
         (un administrador puede desbloquearla desde Seguridad > Usuarios). -->
    <add key="IntentosParaBloqueo" value="5" />
    <add key="MinutosBloqueo" value="5" />
    <!-- Dias de anticipacion para avisar que una membresia esta por vencer -->
    <add key="DiasAvisoVencimiento" value="7" />
  </appSettings>
</configuration>
